# Azure Speech 资源 key（联网 TTS 必需）
# ⚠️ 注意：iOS 版会把该 key 打进 app bundle，存在被逆向提取的风险。
#    请使用受限/可轮换的 key，并监控用量。更安全的做法是改用后端代理或临时 token。
VITE_AZURE_SPEECH_KEY=<your-azure-speech-key>

# Azure Speech 资源端点 URL（联网 TTS 必需）
# 形如：https://<your-resource-name>.cognitiveservices.azure.com/
VITE_AZURE_SPEECH_ENDPOINT=<your-azure-speech-endpoint>

# 可选：覆盖默认音色（默认 zh-CN-XiaoxiaoNeural）
# VITE_AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural
