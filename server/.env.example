# Azure Speech 资源的 API key（TTS backup 必需）
AZURE_SPEECH_KEY=<your-azure-speech-key>

# Azure Speech 资源端点 URL（TTS backup 必需）
# 形如：https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_SPEECH_ENDPOINT=<your-azure-speech-endpoint>

# 可选：覆盖默认端口 / 路径
# PORT=3001
# DB_PATH=./data/pinyin.db
# TTS_CACHE_DIR=./cache
# PINYIN_AUDIO_DIR=./audio/pinyin
